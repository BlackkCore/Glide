    <StreamGeometry x:Key="IconRss">M4 10.2a9.8 9.8 0 0 1 9.8 9.8h-2A7.8 7.8 0 0 0 4 12.2zM4 3.5A16.5 16.5 0 0 1 20.5 20h-2A14.5 14.5 0 0 0 4 5.5zM5.5 17a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M10.3 2h3.4l.5 2.6 1.6.9 2.5-.9 1.7 2.9-2 1.8v1.8l2 1.8-1.7 2.9-2.5-.9-1.6.9-.5 2.6h-3.4l-.5-2.6-1.6-.9-2.5.9-1.7-2.9 2-1.8V9.3l-2-1.8 1.7-2.9 2.5.9 1.6-.9zM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm0 2a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>
    <StreamGeometry x:Key="IconUpdate">M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm1 3v6.6l2.3-2.3 1.4 1.4L12 17.4l-4.7-4.7 1.4-1.4 2.3 2.3V7z</StreamGeometry>
    <StreamGeometry x:Key="IconReload">M12 4a8 8 0 0 1 7.4 5H22l-3.5 4-3.5-4h2.2A6 6 0 1 0 18 14.6l1.7 1.1A8 8 0 1 1 12 4z</StreamGeometry>
    <StreamGeometry x:Key="IconStar">M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9zm0 4.5L10.5 10.5l-3.5.5 2.5 2.4-.6 3.5L12 15.2l3.1 1.7-.6-3.5L17 11l-3.5-.5z</StreamGeometry>
    <StreamGeometry x:Key="IconExit">M5 3h8v2H5v14h8v2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm11.6 4.6L21 12l-4.4 4.4-1.4-1.4 2-2H9v-2h8.2l-2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconMoon">M12.3 3a7 7 0 0 0 8.7 8.7A9 9 0 1 1 12.3 3zM9.7 5.6a7 7 0 1 0 8.7 8.7A9 9 0 0 1 9.7 5.6z</StreamGeometry>
    <StreamGeometry x:Key="IconSun">M11 1h2v3h-2zm0 19h2v3h-2zM1 11h3v2H1zm19 0h3v2h-3zM4.2 2.8l2.1 2.1-1.4 1.4-2.1-2.1zm14.9 14.9 2.1 2.1-1.4 1.4-2.1-2.1zM2.8 19.8l2.1-2.1 1.4 1.4-2.1 2.1zM17.7 4.9l2.1-2.1 1.4 1.4-2.1 2.1zM12 6a6 6 0 1 1 0 12 6 6 0 0 1 0-12zm0 2a4 4 0 1 0 0 8 4 4 0 0 0 0-8z</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9.3 5.3l1.4-1.4 8.1 8.1-8.1 8.1-1.4-1.4 6.7-6.7z</StreamGeometry>
