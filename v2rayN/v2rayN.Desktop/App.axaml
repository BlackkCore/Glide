<Application
    x:Class="v2rayN.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:service="clr-namespace:ServiceLib;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Name="Glide"
    x:DataType="vms:StatusBarViewModel"
    RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/GlobalResources.axaml" />
                <ResourceInclude Source="Assets/AppTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme />
        <StyleInclude Source="Assets/AvaloniaEditTheme.axaml" />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
        <dialogHost:DialogHostStyles />
        <!--  Upstream's shared control styles first, then Glide's design on top (Glide's styles must win).  -->
        <StyleInclude Source="Assets/GlobalStyles.axaml" />
        <StyleInclude Source="Assets/AppStyles.axaml" />

        <Style Selector="dialogHost|DialogHost">
            <Setter Property="OverlayBackground" Value="{DynamicResource SemiColorOverlayBackground}" />
            <Setter Property="Background" Value="{DynamicResource AppBgBrush}" />

            <Setter Property="dialogHost:DialogHostStyle.BoxShadow" Value="{DynamicResource SemiShadowElevated}" />
            <Setter Property="dialogHost:DialogHostStyle.CornerRadius" Value="18" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Command="{Binding NotifyLeftClickCmd}"
                Icon="/Assets/NotifyIcon1.ico"
                ToolTipText="{Binding RunningServerToolTipText, FallbackValue={x:Static service:Global.AppDisplayName}}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem
                            Command="{Binding ShowWindowCmd}"
                            Header="{x:Static resx:ResUI.TbDisplayGUI}"
                            IsVisible="{Binding BlIsNonWindows}" />
                        <NativeMenuItem
                            Command="{Binding NotifyLeftClickCmd}"
                            Header="{x:Static resx:ResUI.menuShowOrHideMainWindow}"
                            IsVisible="{Binding BlIsNonWindows}" />
                        <!--  Glide: App.SetupTrayMenu puts the status line, one Connect / Disconnect item and
                              the Servers list first; the proxy modes and the rest follow, with icons.  -->
                        <NativeMenuItem Header="{x:Static resx:ResUI.menuSystemproxy}">
                            <NativeMenu>
                                <NativeMenuItem
                                    Command="{Binding SystemProxyClearCmd}"
                                    Header="{x:Static resx:ResUI.menuSystemProxyClear}"
                                    IsChecked="{Binding BlSystemProxyClear}"
                                    ToggleType="Radio" />
                                <NativeMenuItem
                                    Command="{Binding SystemProxySetCmd}"
                                    Header="{x:Static resx:ResUI.menuSystemProxySet}"
                                    IsChecked="{Binding BlSystemProxySet}"
                                    ToggleType="Radio" />
                                <NativeMenuItem
                                    Command="{Binding SystemProxyNothingCmd}"
                                    Header="{x:Static resx:ResUI.menuSystemProxyNothing}"
                                    IsChecked="{Binding BlSystemProxyNothing}"
                                    ToggleType="Radio" />
                                <NativeMenuItem
                                    Command="{Binding SystemProxyPacCmd}"
                                    Header="{x:Static resx:ResUI.menuSystemProxyPac}"
                                    IsChecked="{Binding BlSystemProxyPac}"
                                    IsVisible="{Binding BlSystemProxyPacVisible}"
                                    ToggleType="Radio" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="MenuAddServerViaClipboardClick" Header="{x:Static resx:ResUI.menuAddServerViaClipboard}" />
                        <NativeMenuItem Header="{x:Static resx:ResUI.TbNavSubscriptions}">
                            <NativeMenu>
                                <NativeMenuItem Command="{Binding SubUpdateCmd}" Header="{x:Static resx:ResUI.TbSubUpdateAll}" />
                                <NativeMenuItem Command="{Binding SubUpdateViaProxyCmd}" Header="{x:Static resx:ResUI.TbSubUpdateAllViaProxy}" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Command="{Binding CopyProxyCmdToClipboardCmd}" Header="{x:Static resx:ResUI.TbCopyProxyCommand}" />
                        <NativeMenuItem Click="MenuReloadClick" Header="{x:Static resx:ResUI.menuReload}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Command="{Binding ShowWindowCmd}" Header="{x:Static resx:ResUI.TbOpenGlide}" />
                        <NativeMenuItem Click="MenuExit_Click" Header="{x:Static resx:ResUI.menuExit}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
