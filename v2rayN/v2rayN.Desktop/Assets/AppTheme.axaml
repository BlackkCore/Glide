<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Redesign color tokens. Light and Dark; Semi's other variants inherit from one of these.  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!--  Surfaces and text (one cool-gray family)  -->
            <SolidColorBrush x:Key="AppBgBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#E4E6EB" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#D3D7DF" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#11141A" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#5B6170" />
            <SolidColorBrush x:Key="AppFaintBrush" Color="#8C92A0" />
            <SolidColorBrush x:Key="AppSubtleBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="AppSegmentSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppLogBgBrush" Color="#F7F8FA" />
            <SolidColorBrush x:Key="AppNavHoverBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="AppNavActiveBgBrush" Color="#EEF2FE" />
            <SolidColorBrush x:Key="AppNavActiveFgBrush" Color="#2343B8" />
            <!--  Accent  -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#2547C9" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#1E3BA8" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#EEF2FE" />
            <SolidColorBrush x:Key="AppAccentSoftFgBrush" Color="#2343B8" />
            <!--  Dropdown lists: app surface, soft accent for the chosen item (Semi's own keys).  -->
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#E4E6EB" />
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#F3F4F6" />
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#F3F4F6" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#EEF2FE" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#2343B8" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground" Color="#E3E9FD" />
            <SolidColorBrush x:Key="AppAccentRingBrush" Color="#E3E9FD" />
            <!--  Power button  -->
            <LinearGradientBrush x:Key="AppPowerOnFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#4A6EF0" />
                <GradientStop Offset="1" Color="#2A4DD6" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AppOffBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppOffFgBrush" Color="#5B6170" />
            <SolidColorBrush x:Key="AppOffRingBrush" Color="#F1F2F5" />
            <SolidColorBrush x:Key="AppPillOffBgBrush" Color="#F1F2F5" />
            <BoxShadows x:Key="AppPowerOnShadow">0 18 36 -12 #993157E6, 0 2 6 0 #333157E6</BoxShadows>
            <BoxShadows x:Key="AppPowerOffShadow">0 10 24 -12 #3311141A, 0 1 2 0 #1411141A</BoxShadows>
            <!--  Status  -->
            <SolidColorBrush x:Key="AppGoodBgBrush" Color="#E7F6EE" />
            <SolidColorBrush x:Key="AppGoodFgBrush" Color="#12683A" />
            <SolidColorBrush x:Key="AppGoodDotBrush" Color="#1E9E58" />
            <!--  Tables  -->
            <SolidColorBrush x:Key="AppRowSelectedBrush" Color="#EEF2FE" />
            <SolidColorBrush x:Key="AppRowHoverBrush" Color="#F7F8FA" />
            <SolidColorBrush x:Key="AppGridLineBrush" Color="#EFF0F3" />
            <!--  Elevation  -->
            <BoxShadows x:Key="AppCardShadow">0 1 2 0 #0A11141A, 0 8 24 -12 #1F11141A</BoxShadows>
            <BoxShadows x:Key="AppRaisedShadow">0 1 2 0 #1A11141A, 0 1 1 0 #0D11141A</BoxShadows>
            <BoxShadows x:Key="AppToastShadow">0 12 32 -10 #3311141A, 0 2 6 0 #1411141A</BoxShadows>

            <!--  Semi's own palette, re-tinted to the app accent so every control matches  -->
            <SolidColorBrush x:Key="SemiColorPrimary" Color="#3157E6" />
            <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#2547C9" />
            <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#1E3BA8" />
            <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#AFC0F5" />
            <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#EEF2FE" />
            <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#E1E8FD" />
            <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#CCD8FB" />
            <SolidColorBrush x:Key="SemiColorFocusBorder" Color="#3157E6" />
            <SolidColorBrush x:Key="SemiColorLink" Color="#3157E6" />
            <SolidColorBrush x:Key="SemiColorLinkPointerover" Color="#2547C9" />
            <SolidColorBrush x:Key="SemiColorLinkActive" Color="#1E3BA8" />
            <SolidColorBrush x:Key="SemiColorLinkVisited" Color="#3157E6" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground" Color="#3157E6" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="#2547C9" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="#1E3BA8" />
            <!--  Semi controls read these keys directly, so they get the accent here too.  -->
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#3157E6" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#2547C9" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#2547C9" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#1E3BA8" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#1E3BA8" />
            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#3157E6" />
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="#3157E6" />
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#2547C9" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#2547C9" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#1E3BA8" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#1E3BA8" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedBackground" Color="#EEF2FE" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedBorderBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush" Color="#2547C9" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush" Color="#1E3BA8" />
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="DataGridCellFocusBorderBrush" Color="#3157E6" />
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#3157E6" />
            <SolidColorBrush x:Key="HyperlinkButtonPointeroverForeground" Color="#2547C9" />
            <SolidColorBrush x:Key="HyperlinkButtonPressedForeground" Color="#1E3BA8" />
            <SolidColorBrush x:Key="HyperlinkButtonVisitedForeground" Color="#3157E6" />
            <SolidColorBrush x:Key="TabItemLinePipeSelectedBackground" Color="#3157E6" />
            <SolidColorBrush x:Key="RadioButtonCardCheckedBackground" Color="#EEF2FE" />
            <SolidColorBrush x:Key="ProgressBarPrimaryForeground" Color="#3157E6" />
            <SolidColorBrush x:Key="DataGridRowPointeroverBackground" Color="#F7F8FA" />
            <SolidColorBrush x:Key="DataGridRowSelectedBackground" Color="#EEF2FE" />
            <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground" Color="#E6ECFD" />
            <SolidColorBrush x:Key="DataGridCellCurrentBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridColumnHeaderBackground" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBgBrush" Color="#0D0F13" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#15181D" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#242830" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#323844" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#ECEEF2" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#9BA1AE" />
            <SolidColorBrush x:Key="AppFaintBrush" Color="#6C7281" />
            <SolidColorBrush x:Key="AppSubtleBrush" Color="#1C2027" />
            <SolidColorBrush x:Key="AppSegmentSelectedBrush" Color="#2B303A" />
            <SolidColorBrush x:Key="AppLogBgBrush" Color="#111418" />
            <SolidColorBrush x:Key="AppNavHoverBrush" Color="#1C2027" />
            <SolidColorBrush x:Key="AppNavActiveBgBrush" Color="#1A2240" />
            <SolidColorBrush x:Key="AppNavActiveFgBrush" Color="#B7C7FF" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#7393FA" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#4A6BE0" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1A2240" />
            <SolidColorBrush x:Key="AppAccentSoftFgBrush" Color="#B7C7FF" />
            <!--  Dropdown lists: app surface, soft accent for the chosen item (Semi's own keys).  -->
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#1A1E25" />
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#2A2F39" />
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#232833" />
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#232833" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#1F2A4D" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#C9D5FF" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground" Color="#243159" />
            <SolidColorBrush x:Key="AppAccentRingBrush" Color="#18203A" />
            <LinearGradientBrush x:Key="AppPowerOnFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#6D8EFA" />
                <GradientStop Offset="1" Color="#4467E8" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AppOffBgBrush" Color="#1E2229" />
            <SolidColorBrush x:Key="AppOffFgBrush" Color="#B3B9C6" />
            <SolidColorBrush x:Key="AppOffRingBrush" Color="#191C22" />
            <SolidColorBrush x:Key="AppPillOffBgBrush" Color="#1E2229" />
            <BoxShadows x:Key="AppPowerOnShadow">0 18 40 -10 #995A7FF7, 0 2 8 0 #405A7FF7</BoxShadows>
            <BoxShadows x:Key="AppPowerOffShadow">0 10 24 -10 #80000000, inset 0 1 0 0 #0FFFFFFF</BoxShadows>
            <SolidColorBrush x:Key="AppGoodBgBrush" Color="#0F2E1D" />
            <SolidColorBrush x:Key="AppGoodFgBrush" Color="#84E2AC" />
            <SolidColorBrush x:Key="AppGoodDotBrush" Color="#3CC97C" />
            <SolidColorBrush x:Key="AppRowSelectedBrush" Color="#1A2240" />
            <SolidColorBrush x:Key="AppRowHoverBrush" Color="#1A1D23" />
            <SolidColorBrush x:Key="AppGridLineBrush" Color="#1E2128" />
            <BoxShadows x:Key="AppCardShadow">0 1 2 0 #40000000</BoxShadows>
            <BoxShadows x:Key="AppRaisedShadow">0 1 2 0 #66000000, inset 0 1 0 0 #0DFFFFFF</BoxShadows>
            <BoxShadows x:Key="AppToastShadow">0 12 32 -8 #A0000000, 0 1 2 0 #66000000</BoxShadows>

            <SolidColorBrush x:Key="SemiColorPrimary" Color="#5A7FF7" />
            <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#7393FA" />
            <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#4A6BE0" />
            <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#2A3A6E" />
            <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#1A2240" />
            <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#212B4F" />
            <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#28345E" />
            <SolidColorBrush x:Key="SemiColorFocusBorder" Color="#5A7FF7" />
            <SolidColorBrush x:Key="SemiColorLink" Color="#7393FA" />
            <SolidColorBrush x:Key="SemiColorLinkPointerover" Color="#8FA8FB" />
            <SolidColorBrush x:Key="SemiColorLinkActive" Color="#5A7FF7" />
            <SolidColorBrush x:Key="SemiColorLinkVisited" Color="#7393FA" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground" Color="#5A7FF7" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="#7393FA" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="#4A6BE0" />
            <!--  Semi controls read these keys directly, so they get the accent here too.  -->
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#5A7FF7" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#7393FA" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#7393FA" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#4A6BE0" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#4A6BE0" />
            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#8FA6FF" />
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="#5A7FF7" />
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#7393FA" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#7393FA" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#4A6BE0" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#4A6BE0" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedBackground" Color="#1A2240" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedBorderBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush" Color="#7393FA" />
            <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush" Color="#4A6BE0" />
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="DataGridCellFocusBorderBrush" Color="#5A7FF7" />
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#8FA6FF" />
            <SolidColorBrush x:Key="HyperlinkButtonPointeroverForeground" Color="#7393FA" />
            <SolidColorBrush x:Key="HyperlinkButtonPressedForeground" Color="#4A6BE0" />
            <SolidColorBrush x:Key="HyperlinkButtonVisitedForeground" Color="#8FA6FF" />
            <SolidColorBrush x:Key="TabItemLinePipeSelectedBackground" Color="#5A7FF7" />
            <SolidColorBrush x:Key="RadioButtonCardCheckedBackground" Color="#1A2240" />
            <SolidColorBrush x:Key="ProgressBarPrimaryForeground" Color="#5A7FF7" />
            <SolidColorBrush x:Key="MenuFlyoutBackground" Color="#1E2229" />
            <SolidColorBrush x:Key="DataGridRowPointeroverBackground" Color="#1A1D23" />
            <SolidColorBrush x:Key="DataGridRowSelectedBackground" Color="#1A2240" />
            <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground" Color="#1E274A" />
            <SolidColorBrush x:Key="DataGridCellCurrentBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridColumnHeaderBackground" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="ComboBoxPopupBoxCornerRadius">12</CornerRadius>
    <!--  Type scale. Everything in the app uses one of these five sizes; ThemeSettingViewModel
          nudges them up or down when the user picks a different font size.  -->
    <x:Double x:Key="AppFontCaption">11</x:Double>
    <x:Double x:Key="AppFontSmall">12</x:Double>
    <x:Double x:Key="AppFontBody">13</x:Double>
    <x:Double x:Key="AppFontTitle">15</x:Double>
    <x:Double x:Key="AppFontHeading">20</x:Double>

    <FontFamily x:Key="AppMonoFont">avares://Glide/Assets/Fonts#JetBrains Mono, Cascadia Mono, Consolas, monospace</FontFamily>

    <!--  Icons (24x24, filled shapes)  -->
    <StreamGeometry x:Key="IconShield">M12 2.5l7.5 3.2v6.1c0 4.7-3.1 8-7.5 9.7-4.4-1.7-7.5-5-7.5-9.7V5.7zM12 4.7L6.5 7v4.8c0 3.6 2.3 6.2 5.5 7.6 3.2-1.4 5.5-4 5.5-7.6V7zM15.3 9l1.1 1.1-5.1 5.1-3.1-3.1 1.1-1.1 2 2z</StreamGeometry>
    <StreamGeometry x:Key="IconShieldSolid">M12 2.5l7.5 3.2v6.1c0 4.7-3.1 8-7.5 9.7-4.4-1.7-7.5-5-7.5-9.7V5.7zM15.3 9l-4 4-2-2-1.1 1.1 3.1 3.1 5.1-5.1z</StreamGeometry>
    <StreamGeometry x:Key="IconGlider">M102 282 L429 134 L243 307 Z M429 134 L282 410 L251 315 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPower">M11 2h2v10h-2zM6.3 5.6l1.4 1.4A7 7 0 1 0 16.3 7l1.4-1.4A9 9 0 1 1 6.3 5.6z</StreamGeometry>
