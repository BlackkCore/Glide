<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:common="using:v2rayN.Desktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:ent="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignWidth="760"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">

    <StackPanel Spacing="22">

        <!--  Hero: state, headline and the connect button beside a large globe.  -->
        <Grid
            x:Name="gridHero"
            MinHeight="400"
            ColumnDefinitions="380,*">

            <StackPanel
                x:Name="spHeroText"
                VerticalAlignment="Center"
                Spacing="16">
                <Grid MinHeight="30">
                    <Border
                        x:Name="bdPowerState"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Classes="pill">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center" />
                            <TextBlock x:Name="txtPowerState" Text="{x:Static resx:ResUI.TbProxyOff}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="txtHeadline"
                        FontSize="{DynamicResource AppFontDisplay}"
                        FontWeight="ExtraBold"
                        Foreground="{DynamicResource AppTextBrush}"
                        LetterSpacing="-0.8"
                        TextAlignment="Start"
                        TextWrapping="Wrap" />
                    <!--  Connected: the exit country's flag leads the "Exit IP" line.  -->
                    <DockPanel x:Name="pnlExitDetails" MinHeight="24">
                        <Panel
                            x:Name="bdExitFlag"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Classes="flagWrap small"
                            DockPanel.Dock="Left"
                            IsVisible="False">
                            <Border Classes="flag">
                                <Image x:Name="imgExitFlag" />
                            </Border>
                            <Ellipse Classes="flagRing" />
                        </Panel>
                        <TextBlock
                            x:Name="txtRunningInfoDisplay"
                            HorizontalAlignment="Stretch"
                            Classes="muted num"
                            FontSize="{DynamicResource AppFontTitle}"
                            LineHeight="24"
                            TextAlignment="Start"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>

                <!--  The chosen server: flag, name, protocol and address. Click it to pick another.  -->
                <StackPanel
                    x:Name="spRunningServer"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="Hand"
                    Spacing="8">
                    <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Panel
                            x:Name="bdServerFlag"
                            Margin="0,0,10,4"
                            Classes="flagWrap small"
                            IsVisible="False">
                            <Border Classes="flag">
                                <Image x:Name="imgServerFlag" />
                            </Border>
                            <Ellipse Classes="flagRing" />
                        </Panel>
                        <Border
                            x:Name="bdServerCountry"
                            Margin="0,0,10,4"
                            Classes="country"
                            IsVisible="False">
                            <TextBlock x:Name="txtServerCountry" />
                        </Border>
                        <TextBlock
                            x:Name="txtServerName"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Classes="serverName"
                            FontSize="{DynamicResource AppFontTitle}"
                            MaxLines="2"
                            TextAlignment="Start" />
                        <Border
                            x:Name="bdServerType"
                            Margin="0,0,10,4"
                            VerticalAlignment="Center"
                            Classes="badge accent"
                            IsVisible="False">
                            <TextBlock x:Name="txtServerType" />
                        </Border>
                        <TextBlock
                            x:Name="txtServerAddress"
                            Margin="0,0,0,4"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight"
                            Classes="muted"
                            FontSize="{DynamicResource AppFontSmall}"
                            FontWeight="Medium" />
                    </WrapPanel>
                </StackPanel>

                <!--  The one thing to do about a problem: close the app holding the port, or check again.  -->
                <Button
                    x:Name="btnStatusAction"
                    HorizontalAlignment="Left"
                    Classes="statusAction"
                    IsVisible="False" />

                <StackPanel
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="18">
                    <Button
                        x:Name="btnPower"
                        Classes="heroBtn"
                        ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconPower}" />
                            <TextBlock x:Name="txtPowerLabel" Text="{x:Static resx:ResUI.TbConnect}" />
                        </StackPanel>
                    </Button>
                    <!--  Time since the connection was verified; view only, shown while connected.  -->
                    <StackPanel
                        x:Name="spSession"
                        VerticalAlignment="Center"
                        IsVisible="False"
                        Spacing="2">
                        <TextBlock
                            Classes="muted"
                            FontSize="{DynamicResource AppFontSmall}"
                            Text="{x:Static resx:ResUI.TbSessionFor}" />
                        <TextBlock
                            x:Name="txtSessionClock"
                            FlowDirection="LeftToRight"
                            FontFamily="{DynamicResource AppMonoFont}"
                            FontSize="{DynamicResource AppFontHeading}"
                            FontWeight="Medium"
                            Foreground="{DynamicResource AppTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!--  How Connect sends traffic: ticked, through TUN (every app); otherwise through the Windows proxy.
                      Remembered between runs; changing it while connected switches over at once.  -->
                <StackPanel
                    x:Name="spEnableTun"
                    Margin="2,-2,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Orientation="Horizontal"
                    Spacing="8"
                    ToolTip.Tip="{x:Static resx:ResUI.TipTunMode}">
                    <CheckBox
                        x:Name="chkTun"
                        VerticalAlignment="Center"
                        Content="{x:Static resx:ResUI.TbCaptureAllApps}"
                        FontSize="{DynamicResource AppFontBody}"
                        FontWeight="Medium" />
                    <PathIcon
                        x:Name="iconTunAdmin"
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconShield}"
                        Foreground="{DynamicResource AppMutedBrush}"
                        IsVisible="False"
                        ToolTip.Tip="{x:Static resx:ResUI.TipTunNeedsAdmin}" />
                </StackPanel>

                <!--  Shown once, until "Got it" or until TUN is ticked.  -->
                <Border
                    x:Name="bdTunTip"
                    Margin="0,-6,0,0"
                    Padding="12,7,8,7"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource AppAccentSoftBrush}"
                    CornerRadius="10"
                    IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            MaxWidth="270"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource AppFontSmall}"
                            Foreground="{DynamicResource AppAccentSoftFgBrush}"
                            Text="{x:Static resx:ResUI.TipTunFirstRun}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="btnTunTipOk"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Content="{x:Static resx:ResUI.TbGotIt}"
                            FontSize="{DynamicResource AppFontSmall}"
                            FontWeight="Medium"
                            Theme="{DynamicResource BorderlessButton}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Panel
                x:Name="pnlGlobe"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent">
                <common:GlobeView
                    x:Name="globe"
                    FlowDirection="LeftToRight"
                    Width="400"
                    Height="400" />
            </Panel>
        </Grid>

        <!--  Live numbers: download, upload and delay.  -->
        <StackPanel x:Name="spSpeed" Spacing="10">
            <!--  While not connected: the cards show the last session and the selected server's last test.  -->
            <TextBlock
                x:Name="txtLastSession"
                Classes="muted"
                FontSize="{DynamicResource AppFontSmall}"
                FontWeight="Medium"
                IsVisible="False" />
            <Grid ColumnDefinitions="*,14,*,14,*">
                <Border Padding="18,14" Classes="card">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Classes="statDot"
                                DockPanel.Dock="Right" />
                            <TextBlock Classes="statLabel" Text="{x:Static resx:ResUI.TbDownload}" />
                        </DockPanel>
                        <TextBlock
                            x:Name="txtSpeedDown"
                            Classes="statValue"
                            FlowDirection="LeftToRight"
                            FontFamily="{DynamicResource AppMonoFont}"
                            FontSize="{DynamicResource AppFontStat}"
                            FontWeight="Medium" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Padding="18,14"
                    Classes="card">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Classes="statDot"
                                DockPanel.Dock="Right" />
                            <TextBlock Classes="statLabel" Text="{x:Static resx:ResUI.TbUpload}" />
                        </DockPanel>
                        <TextBlock
                            x:Name="txtSpeedUp"
                            Classes="statValue"
                            FlowDirection="LeftToRight"
                            FontFamily="{DynamicResource AppMonoFont}"
                            FontSize="{DynamicResource AppFontStat}"
                            FontWeight="Medium" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="4"
                    Padding="18,14"
                    Classes="card">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Ellipse
                                x:Name="dotPing"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Classes="statDot latency"
                                DockPanel.Dock="Right" />
                            <TextBlock Classes="statLabel" Text="{x:Static resx:ResUI.LvTestDelay}" />
                        </DockPanel>
                        <TextBlock
                            x:Name="txtPingValue"
                            Classes="statValue"
                            FlowDirection="LeftToRight"
                            FontFamily="{DynamicResource AppMonoFont}"
                            FontSize="{DynamicResource AppFontStat}"
                            FontWeight="Medium"
                            Text="—" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!--  Quick settings as chips: routing, capture all apps, and a way into the advanced options.  -->
        <StackPanel Spacing="14">
            <DockPanel LastChildFill="True">
            <!--  Step-by-step check with a plain answer; shown while not connected.  -->
            <Button
                x:Name="btnDiagnose"
                Margin="12,0,0,12"
                VerticalAlignment="Top"
                Height="48"
                Content="{x:Static resx:ResUI.TbDiagnose}"
                DockPanel.Dock="Right"
                FontSize="{DynamicResource AppFontBody}"
                FontWeight="Medium"
                IsVisible="False"
                Theme="{DynamicResource BorderlessButton}" />
            <WrapPanel Orientation="Horizontal">
                <Border
                    Margin="0,0,12,12"
                    Padding="16,0,6,0"
                    Classes="chip">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="muted"
                            FontSize="{DynamicResource AppFontBody}"
                            Text="{x:Static resx:ResUI.menuRouting}" />
                        <!--  Dropdown rows explain each built-in mode; the closed box shows the name only.  -->
                        <ComboBox
                            x:Name="cmbRoutings2"
                            MinWidth="190"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            ItemsSource="{Binding RoutingItems}"
                            ToolTip.Tip="{x:Static resx:ResUI.menuRouting}">
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="ent:RoutingItem">
                                    <TextBlock Text="{Binding Remarks, Converter={x:Static conv:RoutingNameConverter.Instance}}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ent:RoutingItem">
                                    <StackPanel MaxWidth="280" Margin="0,3" Spacing="2">
                                        <TextBlock FontWeight="Medium" Text="{Binding Remarks, Converter={x:Static conv:RoutingNameConverter.Instance}}" />
                                        <TextBlock
                                            Classes="muted"
                                            FontSize="{DynamicResource AppFontSmall}"
                                            IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Text="{Binding Remarks, Converter={x:Static conv:RoutingNameConverter.Instance}, ConverterParameter=desc}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!--  Advanced: opens in place below; open on its own when the proxy mode is Unchanged or PAC.  -->
                <Button
                    x:Name="btnAdvanced"
                    Margin="0,0,0,12"
                    Padding="16,0"
                    Classes="chip"
                    ToolTip.Tip="{x:Static resx:ResUI.TipAdvancedConnection}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource AppFontBody}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AppTextBrush}"
                            Text="{x:Static resx:ResUI.TbAdvancedConnection}" />
                        <PathIcon
                            x:Name="iconAdvanced"
                            Classes="disclosureChevron"
                            Data="{StaticResource IconChevronRight}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            </DockPanel>

            <Border
                x:Name="spAdvancedCard"
                Classes="card"
                IsVisible="{Binding #spAdvanced.IsVisible}">
                <StackPanel
                    x:Name="spAdvanced"
                    IsVisible="False"
                    Spacing="14">
                    <TextBlock
                        x:Name="txtAdvancedSummary"
                        Classes="muted"
                        FontSize="{DynamicResource AppFontCaption}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="{x:Static resx:ResUI.menuSystemproxy}" />
                        <ListBox x:Name="cmbSystemProxy" Theme="{StaticResource SegmentListBox}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="{x:Static resx:ResUI.TbProxyModeOff}" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxyClear}" />
                            <ListBoxItem Content="{x:Static resx:ResUI.TbProxyModeOn}" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxySet}" />
                            <ListBoxItem Content="{x:Static resx:ResUI.TbProxyModeUnchanged}" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                            <ListBoxItem Content="PAC" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxyPac}" />
                        </ListBox>
                    </StackPanel>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,6,Auto">
                        <TextBlock x:Name="txtInboundKey" Classes="kvKey" />
                        <TextBlock
                            x:Name="txtInboundValue"
                            Grid.Column="1"
                            Classes="kvValue" />
                        <TextBlock
                            x:Name="txtInboundLanKey"
                            Grid.Row="2"
                            Classes="kvKey" />
                        <TextBlock
                            x:Name="txtInboundLanValue"
                            Grid.Row="2"
                            Grid.Column="1"
                            Classes="kvValue" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
