<UserControl
    x:Class="v2rayN.Desktop.Views.AddServerSheet"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Width="560"
    mc:Ignorable="d">
    <!--  One place to add servers: paste (with a preview of what was found), scan, or type them in.  -->
    <StackPanel Margin="24,22" Spacing="12">
        <TextBlock Classes="h2" Text="{x:Static resx:ResUI.TbAddServer}" />
        <TextBlock
            Classes="muted"
            FontSize="{DynamicResource AppFontBody}"
            Text="{x:Static resx:ResUI.TipAddServerSheet}"
            TextWrapping="Wrap" />

        <!--  Links read left to right, also in the Persian UI.  -->
        <TextBox
            x:Name="txtImport"
            Height="112"
            AutomationProperties.Name="{x:Static resx:ResUI.TbAddServer}"
            AcceptsReturn="True"
            FlowDirection="LeftToRight"
            FontFamily="{DynamicResource AppMonoFont}"
            FontSize="{DynamicResource AppFontSmall}"
            PlaceholderText="vless://…   vmess://…   https://…"
            TextWrapping="Wrap" />

        <DockPanel>
            <Button
                x:Name="btnPaste"
                Content="{x:Static resx:ResUI.TbPaste}"
                CornerRadius="8"
                DockPanel.Dock="Left" />
            <TextBlock
                x:Name="txtPreview"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="{DynamicResource AppFontSmall}"
                FontWeight="Medium"
                TextWrapping="Wrap" />
        </DockPanel>

        <Separator Margin="0,4" />

        <TextBlock
            Classes="muted"
            FontSize="{DynamicResource AppFontSmall}"
            FontWeight="Medium"
            Text="{x:Static resx:ResUI.TbOtherWays}" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button
                x:Name="btnScanScreen"
                Content="{x:Static resx:ResUI.menuAddServerViaScan}"
                CornerRadius="8" />
            <Button
                x:Name="btnScanImage"
                Content="{x:Static resx:ResUI.menuAddServerViaImage}"
                CornerRadius="8" />
            <Button
                x:Name="btnManual"
                Content="{x:Static resx:ResUI.TbEnterManually}"
                CornerRadius="8" />
        </WrapPanel>

        <StackPanel
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="btnCancel"
                MinWidth="96"
                Content="{x:Static resx:ResUI.TbCancel}"
                CornerRadius="10"
                IsCancel="True" />
            <Button
                x:Name="btnImport"
                MinWidth="120"
                Classes="Primary"
                Content="{x:Static resx:ResUI.TbImport}"
                CornerRadius="10"
                IsDefault="True"
                IsEnabled="False"
                Theme="{DynamicResource SolidButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
