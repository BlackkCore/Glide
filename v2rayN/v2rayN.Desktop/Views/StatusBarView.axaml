<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:common="using:v2rayN.Desktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:ent="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignWidth="320"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">

    <StackPanel Spacing="16">

        <!--  Connection  -->
        <Border Padding="22,20,22,18" Classes="card">
            <StackPanel Spacing="14">
                <Border x:Name="bdPowerState" Classes="pill">
                    <Border.RenderTransform>
                        <ScaleTransform />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center" />
                        <TextBlock x:Name="txtPowerState" Text="{x:Static resx:ResUI.TbProxyOff}" />
                    </StackPanel>
                </Border>

                <Button
                    x:Name="btnPower"
                    Classes="power"
                    ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                    <PathIcon Data="{StaticResource IconPower}" />
                </Button>

                <StackPanel
                    x:Name="spRunningServer"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="Hand"
                    Spacing="7">
                    <TextBlock x:Name="txtServerName" Classes="serverName" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Panel
                            x:Name="bdServerFlag"
                            Classes="flagWrap small"
                            IsVisible="False">
                            <Border Classes="flag">
                                <Image x:Name="imgServerFlag" />
                            </Border>
                            <Ellipse Classes="flagRing" />
                        </Panel>
                        <Border
                            x:Name="bdServerCountry"
                            Classes="country"
                            IsVisible="False">
                            <TextBlock x:Name="txtServerCountry" />
                        </Border>
                        <Border
                            x:Name="bdServerType"
                            Classes="badge accent"
                            IsVisible="False">
                            <TextBlock x:Name="txtServerType" />
                        </Border>
                        <TextBlock
                            x:Name="txtServerAddress"
                            MaxWidth="180"
                            VerticalAlignment="Center"
                            Classes="muted"
                            FontSize="{DynamicResource AppFontSmall}"
                            FontWeight="Medium"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        x:Name="txtRunningInfoDisplay"
                        HorizontalAlignment="Center"
                        Classes="faint num"
                        FontSize="{DynamicResource AppFontSmall}"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!--  The one thing to do about a problem: close the app holding the port, or check again.  -->
                    <Button
                        x:Name="btnStatusAction"
                        HorizontalAlignment="Center"
                        Classes="statusAction"
                        IsVisible="False" />
                    <!--  Step-by-step check with a plain answer; shown while not connected.  -->
                    <Button
                        x:Name="btnDiagnose"
                        HorizontalAlignment="Center"
                        Content="{x:Static resx:ResUI.TbDiagnose}"
                        FontSize="{DynamicResource AppFontSmall}"
                        IsVisible="False"
                        Theme="{DynamicResource BorderlessButton}" />
                </StackPanel>

                <StackPanel x:Name="spSpeed" Spacing="8">
                    <!--  Download first: it's the number people look for.  -->
                    <Grid ColumnDefinitions="*,8,*">
                        <Border Classes="stat">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Classes="down" Data="{StaticResource IconArrowDown}" />
                                    <TextBlock Classes="statLabel" Text="{x:Static resx:ResUI.TbDownload}" />
                                </StackPanel>
                                <TextBlock x:Name="txtSpeedDown" Classes="statValue" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="stat">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Classes="up" Data="{StaticResource IconArrowUp}" />
                                    <TextBlock Classes="statLabel" Text="{x:Static resx:ResUI.TbUpload}" />
                                </StackPanel>
                                <TextBlock x:Name="txtSpeedUp" Classes="statValue" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <common:SpeedSparkline
                        x:Name="sparkSpeed"
                        Height="40"
                        Margin="2,2,2,0"
                        ToolTip.Tip="{x:Static resx:ResUI.TipSpeedGraph}" />
                    <TextBlock
                        x:Name="txtSpeedDirect"
                        HorizontalAlignment="Center"
                        Classes="faint num"
                        FontSize="{DynamicResource AppFontCaption}"
                        FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Connection: routing and TUN up front; the Windows proxy mode and ports under Advanced,
              since the power button already switches the proxy on and off.  -->
        <Border Classes="card">
            <StackPanel Spacing="14">
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{x:Static resx:ResUI.menuRouting}" />
                    <!--  Dropdown rows explain each built-in mode; the closed box shows the name only.  -->
                    <ComboBox
                        x:Name="cmbRoutings2"
                        HorizontalAlignment="Stretch"
                        CornerRadius="10"
                        ItemsSource="{Binding RoutingItems}"
                        ToolTip.Tip="{x:Static resx:ResUI.menuRouting}">
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="ent:RoutingItem">
                                <TextBlock Text="{Binding Remarks, Converter={x:Static conv:RoutingNameConverter.Instance}}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ent:RoutingItem">
                                <StackPanel MaxWidth="280" Margin="0,3" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Remarks, Converter={x:Static conv:RoutingNameConverter.Instance}}" />
                                    <TextBlock
                                        Classes="muted"
                                        FontSize="{DynamicResource AppFontSmall}"
                                        IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Text="{Binding Remarks, Converter={x:Static conv:RoutingNameConverter.Instance}, ConverterParameter=desc}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <DockPanel
                    x:Name="spEnableTun"
                    Background="Transparent"
                    ToolTip.Tip="{x:Static resx:ResUI.TipTunMode}">
                    <ToggleSwitch
                        x:Name="togEnableTun"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Theme="{DynamicResource SimpleToggleSwitch}" />
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            FontSize="{DynamicResource AppFontBody}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AppTextBrush}"
                            Text="{x:Static resx:ResUI.TbCaptureAllApps}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="muted"
                            FontSize="{DynamicResource AppFontCaption}"
                            Text="{x:Static resx:ResUI.TbAdministrator}" />
                    </StackPanel>
                </DockPanel>

                <Border Classes="divider" />

                <!--  Advanced: opens in place; open on its own when the proxy mode is Unchanged or PAC.  -->
                <Button
                    x:Name="btnAdvanced"
                    Classes="disclosure"
                    ToolTip.Tip="{x:Static resx:ResUI.TipAdvancedConnection}">
                    <DockPanel>
                        <PathIcon
                            x:Name="iconAdvanced"
                            Classes="disclosureChevron"
                            Data="{StaticResource IconChevronRight}"
                            DockPanel.Dock="Right" />
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                FontSize="{DynamicResource AppFontBody}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AppTextBrush}"
                                Text="{x:Static resx:ResUI.TbAdvancedConnection}" />
                            <TextBlock
                                x:Name="txtAdvancedSummary"
                                Classes="muted"
                                FontSize="{DynamicResource AppFontCaption}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Button>

                <StackPanel
                    x:Name="spAdvanced"
                    IsVisible="False"
                    Spacing="14">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="{x:Static resx:ResUI.menuSystemproxy}" />
                        <ListBox x:Name="cmbSystemProxy" Theme="{StaticResource SegmentListBox}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="{x:Static resx:ResUI.TbProxyModeOff}" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxyClear}" />
                            <ListBoxItem Content="{x:Static resx:ResUI.TbProxyModeOn}" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxySet}" />
                            <ListBoxItem Content="{x:Static resx:ResUI.TbProxyModeUnchanged}" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                            <ListBoxItem Content="PAC" ToolTip.Tip="{x:Static resx:ResUI.menuSystemProxyPac}" />
                        </ListBox>
                    </StackPanel>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,6,Auto">
                        <TextBlock x:Name="txtInboundKey" Classes="kvKey" />
                        <TextBlock
                            x:Name="txtInboundValue"
                            Grid.Column="1"
                            Classes="kvValue" />
                        <TextBlock
                            x:Name="txtInboundLanKey"
                            Grid.Row="2"
                            Classes="kvKey" />
                        <TextBlock
                            x:Name="txtInboundLanValue"
                            Grid.Row="2"
                            Grid.Column="1"
                            Classes="kvValue" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
