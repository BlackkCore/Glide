<!--
    All of Glide's motion lives here. App.Initialize only loads this file when the Windows
    "Animation effects" setting is on (see Common/AppMotion.cs); without it every state change
    simply snaps. Nothing here loops: each animation runs once in response to a change.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ===== Theme switch: surfaces fade to their new color instead of flashing =====  -->
    <Style Selector="Window">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.sidebar, Border.stat, Border.logPanel">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>

    <!--  ===== Cards =====  -->
    <Style Selector="Border.card">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Hidden until the main window has opened; MainWindow.PlayCardEntrance then raises them one by one.  -->
    <Style Selector=":is(Control).entering Border.card">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!--  ===== Hover backgrounds on sidebar items, chips and segments =====  -->
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot, ListBoxItem /template/ Border#PART_Bg">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Chips and segments give a little under the pointer.  -->
    <Style Selector="ListBoxItem:pressed /template/ Border#PART_Bg">
        <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>
    <!--  The sidebar chevron leans toward the submenu it opens.  -->
    <Style Selector="MenuItem /template/ PathIcon#PART_Chevron">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ PathIcon#PART_Chevron, MenuItem:open /template/ PathIcon#PART_Chevron">
        <Setter Property="RenderTransform" Value="translateX(3px)" />
    </Style>

    <!--  Sidebar accent bar: fades in and stretches to full height when a menu opens.  -->
    <Style Selector="MenuItem /template/ Border#PART_Indicator">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="MenuItem:open /template/ Border#PART_Indicator">
        <Style.Animations>
            <Animation Easing="CubicEaseOut" Duration="0:0:0.18" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.3" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!--  Connecting: the power button's halo breathes until the connection is confirmed.  -->
    <Style Selector="Button.power.checking /template/ Ellipse#PART_Halo">
        <Style.Animations>
            <Animation IterationCount="Infinite" PlaybackDirection="Alternate" Duration="0:0:0.9" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.15" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.6" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!--  Sidebar hover: only the background and colour change, quickly and evenly; nothing moves.  -->
    <Style Selector="Menu.sidebar MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="QuadraticEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Menu.sidebar > MenuItem:pointerover /template/ PathIcon#PART_Chevron, Menu.sidebar > MenuItem:open /template/ PathIcon#PART_Chevron">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <!--  Sidebar popups settle in: a quick fade with a 6px slide away from the sidebar.  -->
    <Style Selector="Menu.sidebar MenuItem:open /template/ Border#PART_PopupBorder">
        <Style.Animations>
            <Animation Easing="CubicEaseOut" Duration="0:0:0.16" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.X" Value="-6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.X" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!--  ===== Buttons: a short press-in so clicks feel physical =====  -->
    <Style Selector="Button.IconButton, Button#btnSave, Button#btnYes, Button#btnCancel, Button#btnNo, Button#btnReset, Button#btnEmptyPaste, Button#btnEmptyAddSub">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.IconButton:pressed">
        <Setter Property="RenderTransform" Value="scale(0.88)" />
    </Style>
    <Style Selector="Button#btnSave:pressed, Button#btnYes:pressed, Button#btnCancel:pressed, Button#btnNo:pressed, Button#btnReset:pressed, Button#btnEmptyPaste:pressed, Button#btnEmptyAddSub:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!--  ===== Menus, dropdowns and tooltips fade in =====  -->
    <Style Selector="PopupRoot /template/ ContentPresenter#PART_ContentPresenter">
        <Style.Animations>
            <Animation Easing="CubicEaseOut" Duration="0:0:0.14">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!--  ===== Status pill: recolors, and pops once when the proxy comes on =====  -->
    <Style Selector="Border.pill">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.25" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.pill.on">
        <Style.Animations>
            <Animation Easing="BackEaseOut" Duration="0:0:0.42">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="0.86" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.86" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!--  ===== Latency dot fades from gray (testing) to its result color =====  -->
    <Style Selector="Ellipse.delayDot">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.35" />
            </Transitions>
        </Setter>
    </Style>

    <!--  ===== Power button: crossfade between off and on, ripple when it turns on =====  -->
    <Style Selector="Button.power">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.power /template/ Ellipse#PART_Halo">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
                <BrushTransition Property="Fill" Duration="0:0:0.35" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.power /template/ Ellipse#PART_HaloInner">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.power /template/ Border#PART_Ring">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.35" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.power /template/ Border#PART_OnFill">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.power.pulse /template/ Ellipse#PART_Ripple">
        <Style.Animations>
            <Animation
                Easing="CubicEaseOut"
                FillMode="Forward"
                Duration="0:0:0.8">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.7" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.92" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.92" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1.3" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.3" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.power.pulse /template/ Panel#PART_Bounce">
        <Style.Animations>
            <Animation Easing="CubicEaseOut" Duration="0:0:0.45">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                </KeyFrame>
                <KeyFrame Cue="55%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.04" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.04" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!--  While the theme reveal runs, colours snap straight to the new theme underneath the old-theme
          picture; otherwise the circle would uncover half-faded, muddy surfaces. Keep this block last.  -->
    <Style Selector="Window.themeSwap, Window.themeSwap Border, Window.themeSwap Ellipse, Window.themeSwap Button, Window.themeSwap Button /template/ Ellipse, Window.themeSwap Button /template/ Border, Window.themeSwap MenuItem /template/ Border, Window.themeSwap ListBoxItem /template/ Border">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
</Styles>
