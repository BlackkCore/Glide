<UserControl
    x:Class="v2rayN.Desktop.Views.DiagnoseSheet"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Width="480"
    mc:Ignorable="d">
    <!--  "Why can't I connect?": each step as it finishes, then one plain answer.  -->
    <StackPanel Margin="24,22" Spacing="14">
        <TextBlock Classes="h2" Text="{x:Static resx:ResUI.TbDiagTitle}" />

        <StackPanel x:Name="spSteps" Spacing="10" />

        <Border
            Padding="14,12"
            Background="{DynamicResource AppSubtleBrush}"
            CornerRadius="12">
            <TextBlock
                x:Name="txtVerdict"
                FontSize="{DynamicResource AppFontBody}"
                FontWeight="Medium"
                TextWrapping="Wrap" />
        </Border>

        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="btnDnsLeak"
                Content="{x:Static resx:ResUI.TbCheckDnsLeak}"
                CornerRadius="10" />
            <Button
                x:Name="btnRunAgain"
                MinWidth="96"
                Content="{x:Static resx:ResUI.TbRunAgain}"
                CornerRadius="10" />
            <Button
                x:Name="btnClose"
                MinWidth="96"
                Classes="Primary"
                Content="{x:Static resx:ResUI.TbClose}"
                CornerRadius="10"
                IsCancel="True"
                Theme="{DynamicResource SolidButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
