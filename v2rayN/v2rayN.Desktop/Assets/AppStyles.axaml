<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib">
    <Design.PreviewWith>
        <Border Padding="20" Classes="card">
            <TextBlock Classes="h2" Text="Preview" />
        </Border>
    </Design.PreviewWith>

    <!--  Windows: dialogs sit on the surface color (the main window sets the gray canvas itself)  -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!--  ===== Dialogs =====  -->
    <Style Selector="StackPanel.dialogFooter">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="4,14,4,2" />
    </Style>
    <Style Selector="Button#btnSave, Button#btnYes">
        <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
    </Style>
    <Style Selector="Button#btnSave, Button#btnYes, Button#btnCancel, Button#btnNo, Button#btnReset">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button#btnCancel, Button#btnNo, Button#btnReset">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!--  Tables everywhere: one line per cell, hairline row separators  -->
    <Style Selector="DataGrid">
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppGridLineBrush}" />
    </Style>
    <Style Selector="DataGridCell :is(TextBlock)">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  Cards and tiles  -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="{DynamicResource AppCardShadow}" />
    </Style>
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <!--  Text  -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{DynamicResource AppFontHeading}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{DynamicResource AppFontTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.num">
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>

    <!--  Small badges: protocol type, counts, "active"  -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontCaption}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.badge.accent">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>
    <Style Selector="Border.badge.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentSoftFgBrush}" />
    </Style>
    <Style Selector="Border.badge.solid">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.badge.solid TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Border.badge.round">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <!--  The server in use: the "live" (cyan) tint, the same as the Connected pill.  -->
    <!--  The chosen server: brand (indigo) tint, since it's chosen whether or not traffic flows.  -->
    <Style Selector="Border.badge.inUse">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.badge.inUse TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentSoftFgBrush}" />
    </Style>

    <!--  ===== Sidebar =====  -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="14,20,14,16" />
    </Style>
    <Style Selector="Border.brandMark">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppPowerOnFill}" />
        <Setter Property="BoxShadow" Value="0 4 10 -4 #804F46E5" />
    </Style>
    <Style Selector="Border.brandMark PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
        <Setter Property="FontSize" Value="{DynamicResource AppFontCaption}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
        <Setter Property="Margin" Value="12,0,0,6" />
    </Style>
    <Style Selector="Menu.sidebar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource SidebarMenuItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="Menu.sidebar PathIcon.nav">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="{Binding $parent[MenuItem].Foreground}" />
    </Style>
    <!--  Section headings (Connect / Manage / App); a thin line instead when the sidebar is compact.  -->
    <Style Selector="Menu.sidebar > MenuItem.section">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,10,12,4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Menu.sidebar > MenuItem.section.first">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="12,2,12,4" />
    </Style>
    <Style Selector="Menu.sidebar TextBlock.sectionText">
        <Setter Property="FontSize" Value="{DynamicResource AppFontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Menu.sidebar Border.sectionLine">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!--  "A new version is ready" dot on the Check update icon.  -->
    <Style Selector="Ellipse.updateDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="13,-2,0,0" />
        <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Border.sidebarRule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,0,6,12" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Menu.sidebar TextBlock.nav">
        <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{Binding $parent[MenuItem].Foreground}" />
    </Style>
    <Style Selector="Menu.sidebar > Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,10" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <!--  Icons on menu rows (sidebar popups, right-click menus, dropdowns); colour comes from the row's template.  -->
    <Style Selector="PathIcon.sub">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <!--  Every right-click menu and dropdown uses the same rows as the sidebar popups.  -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource SidebarSubItem}" />
    </Style>
    <!--  Dividers inside menus.  -->
    <Style Selector="Menu.sidebar MenuItem Separator, ContextMenu Separator, MenuFlyoutPresenter Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Margin" Value="10,5" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <!--  Theme switch (Light | Dark | Auto) at the bottom of the sidebar: same 42px height as the
          sidebar rows, full width.  -->
    <Style Selector="Border.themeSwitch">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Height" Value="42" />
    </Style>
    <Style Selector="Button.themeOpt">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.themeOpt PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.themeOpt TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.themeOpt:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.themeOpt.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSegmentSelectedBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource AppRaisedShadow}" />
    </Style>
    <Style Selector="Button.themeOpt.active">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!--  Compact sidebar (narrow windows): icons only  -->
    <Style Selector=":is(Control).compactOnly">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.sidebar.compact">
        <Setter Property="Padding" Value="10,20,10,16" />
    </Style>
    <Style Selector="Border.sidebar.compact :is(Control).wideOnly">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.sidebar.compact :is(Control).compactOnly">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.sidebar.compact StackPanel.brand">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,26" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar TextBlock.nav">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar > MenuItem">
        <Setter Property="Padding" Value="19,0" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar > MenuItem /template/ PathIcon#PART_Chevron">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar > Separator">
        <Setter Property="Margin" Value="8,10" />
    </Style>
    <!--  Compact: icons sit in the exact middle (no gap reserved for the hidden label).  -->
    <Style Selector="Border.sidebar.compact Menu.sidebar PathIcon.nav">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar > MenuItem.section">
        <Setter Property="Height" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar > MenuItem.section.first">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar TextBlock.sectionText">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.sidebar.compact Menu.sidebar Border.sectionLine">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.sidebar.compact Ellipse.updateDot">
        <Setter Property="Margin" Value="11,-3,0,0" />
    </Style>
    <Style Selector="Button.themeOpt.themeCompact">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.themeOpt.themeCompact PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.themeOpt.themeCompact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}" />
    </Style>

    <!--  ===== Connection card =====  -->
    <Style Selector="Button.power">
        <Setter Property="Width" Value="156" />
        <Setter Property="Height" Value="156" />
        <Setter Property="Background" Value="{DynamicResource AppOffBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AppOffFgBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Ellipse Name="PART_Halo" Fill="{DynamicResource AppOffRingBrush}">
                    </Ellipse>
                    <Ellipse
                        Name="PART_HaloInner"
                        Margin="10"
                        Fill="{DynamicResource AppAccentRingBrush}"
                        Opacity="0">
                    </Ellipse>
                    <!--  One-shot ring that spreads out when the proxy turns on (class "pulse", set from code).  -->
                    <Ellipse
                        Name="PART_Ripple"
                        Margin="20"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Stroke="{DynamicResource AppAccentBrush}"
                        StrokeThickness="2">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Panel Name="PART_Bounce">
                    <Panel.RenderTransform>
                        <ScaleTransform />
                    </Panel.RenderTransform>
                    <Border
                        Name="PART_Ring"
                        Margin="20"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="{DynamicResource AppPowerOffShadow}"
                        CornerRadius="58">
                        <Panel>
                            <!--  The gradient fades in over the off surface, so on/off is a crossfade rather than a jump.  -->
                            <Border
                                Name="PART_OnFill"
                                Background="{DynamicResource AppPowerOnFill}"
                                CornerRadius="58"
                                Opacity="0">
                            </Border>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Panel>
                    </Border>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.power PathIcon">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.power:pointerover /template/ Border#PART_Ring">
        <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="Button.power:pressed /template/ Border#PART_Ring">
        <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>
    <Style Selector="Button.power:focus-visible /template/ Border#PART_Ring">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.power.on">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.power.on /template/ Border#PART_OnFill">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.power.on /template/ Border#PART_Ring">
        <Setter Property="BoxShadow" Value="{DynamicResource AppPowerOnShadow}" />
    </Style>
    <!--  Connected: a cyan "protected" halo around the indigo button.  -->
    <Style Selector="Button.power.on /template/ Ellipse#PART_Halo">
        <Setter Property="Fill" Value="{DynamicResource AppGoodBgBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.power.on /template/ Ellipse#PART_HaloInner">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!--  Status pill above the power button  -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Background" Value="{DynamicResource AppPillOffBgBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppOffFgBrush}" />
    </Style>
    <Style Selector="Border.pill Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="Border.pill.on">
        <Setter Property="Background" Value="{DynamicResource AppGoodBgBrush}" />
    </Style>
    <Style Selector="Border.pill.on TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppGoodFgBrush}" />
    </Style>
    <Style Selector="Border.pill.on Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AppGoodDotBrush}" />
    </Style>
    <!--  Checking (amber) and a problem (red): no internet, port in use, engine stopped.  -->
    <Style Selector="Border.pill.warn">
        <Setter Property="Background" Value="{DynamicResource AppWarnBgBrush}" />
    </Style>
    <Style Selector="Border.pill.warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppWarnFgBrush}" />
    </Style>
    <Style Selector="Border.pill.warn Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AppWarnDotBrush}" />
    </Style>
    <Style Selector="Border.pill.bad">
        <Setter Property="Background" Value="{DynamicResource AppBadBgBrush}" />
    </Style>
    <Style Selector="Border.pill.bad TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppBadFgBrush}" />
    </Style>
    <Style Selector="Border.pill.bad Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AppBadDotBrush}" />
    </Style>
    <!--  "Hide logs" / "Logs": a quiet text link in the server card's bottom corner.  -->
    <Style Selector="Button.logsToggle">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.logsToggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
    </Style>
    <!--  The single fix-it action under the connection status.  -->
    <Style Selector="Button.statusAction">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentSoftFgBrush}" />
    </Style>

    <!--  Server name under the power button  -->
    <Style Selector="TextBlock.serverName">
        <Setter Property="FontSize" Value="{DynamicResource AppFontHeading}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  Live speed tiles  -->
    <Style Selector="Border.stat">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.stat PathIcon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <!--  Same colours as the speed graph: download indigo (filled), upload cyan (line).  -->
    <Style Selector="Border.stat PathIcon.down">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.stat PathIcon.up">
        <Setter Property="Foreground" Value="{DynamicResource AppGoodDotBrush}" />
    </Style>

    <!--  "Advanced" row in the Connection card: a full-width row that opens in place.  -->
    <Style Selector="Button.disclosure">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="-8,-6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}" />
    </Style>
    <Style Selector="PathIcon.disclosureChevron">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="Button.disclosure.open PathIcon.disclosureChevron">
        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="TextBlock.statLabel">
        <Setter Property="FontSize" Value="{DynamicResource AppFontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontSize" Value="{DynamicResource AppFontTitle}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  Key / value rows (inbound ports)  -->
    <Style Selector="TextBlock.kvKey">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.kvValue">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  ===== Toolbars =====  -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.toolbar Button.IconButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border.toolbar PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.toolbar Button.IconButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Border.toolbar Border.toolbarSep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="4,7" />
        <Setter Property="Background" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>

    <!--  Search / filter boxes  -->
    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
    </Style>
    <Style Selector="TextBox.search PathIcon.searchIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>

    <!--  Primary/secondary buttons  -->
    <Style Selector="Button.dark">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppSurfaceBrush}" />
    </Style>
    <Style Selector="Button.dark PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AppSurfaceBrush}" />
    </Style>
    <Style Selector="Button.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppSurfaceBrush}" />
    </Style>

    <!--  ===== Server table =====  -->
    <Style Selector="DataGrid.servers">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppGridLineBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style Selector="DataGrid.servers DataGridColumnHeader">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style Selector="DataGrid.servers DataGridCell">
        <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="DataGrid.servers DataGridCell :is(TextBlock)">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGrid.servers DataGridColumnHeader TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="DataGrid.servers TextBlock.cellMuted">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="DataGrid.servers TextBlock.cellNum">
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="DataGrid.servers Ellipse.delayDot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  List view: one taller row per server, no column headers  -->
    <Style Selector="DataGrid.servers.list">
        <Setter Property="RowHeight" Value="58" />
        <Setter Property="HeadersVisibility" Value="None" />
    </Style>
    <Style Selector="Border.activeBar">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.delayPill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
    </Style>
    <Style Selector="TextBlock.serverLine">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>

    <!--  ===== Log pane =====  -->
    <Style Selector="Border.logPanel">
        <Setter Property="Background" Value="{DynamicResource AppLogBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="TextBlock.toggleLabel">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ===== Main window title bar (Windows) =====  -->
    <!--  The window draws up to the top edge, with the brand in the sidebar: keep only minimize, maximize and close.  -->
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel TextBlock">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--  Grid scrollbars stay thin until hovered instead of covering the last row and column.  -->
    <Style Selector="DataGrid /template/ ScrollViewer">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <Style Selector="DataGrid /template/ ScrollBar">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <!--  No arrow buttons on any scrollbar; wheel and thumb do the job and the arrows read as clutter.  -->
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!--  The track's own page buttons stay, so clicking beside the thumb still pages.  -->
    <Style Selector="ScrollBar /template/ Track > RepeatButton">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!--  ===== Country chip in the server list =====  -->
    <Style Selector="Border.country">
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!--  Round flag (FlagImages), with a hairline so white flags don't melt into the card.  -->
    <Style Selector="Panel.flagWrap">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.flagWrap.small">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Panel.flagWrap > Border.flag">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Panel.flagWrap Image">
        <Setter Property="Stretch" Value="UniformToFill" />
    </Style>
    <!--  Thin ring on top of the clipped flag, so white bands don't melt into a white card.  -->
    <Style Selector="Panel.flagWrap > Ellipse.flagRing">
        <Setter Property="Stroke" Value="{DynamicResource AppFlagRingBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.country TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource AppMonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>

    <!--  ===== Settings window: section list on the left, each section in a card =====  -->
    <Style Selector="Window.settings">
        <Setter Property="Background" Value="{DynamicResource AppBgBrush}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <!--  Older dialogs (routing, rules, subscriptions): Settings' background, toolbar and tables as cards.  -->
    <Style Selector="Window.dialogCards Menu">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Window.dialogCards DataGrid">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--  Keyboard focus is always visible on icon buttons (the library's ring is faint).  -->
    <Style Selector="Button.IconButton:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!--  Touch: bigger targets once the window has been used with a finger (MainWindow sets .touch).  -->
    <Style Selector="Window.touch Button.IconButton">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="Window.touch ListBoxItem, Window.touch MenuItem">
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <!--  A delay test running: the pill dims instead of showing nothing.  -->
    <Style Selector="Border.delayPill.testing">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!--  List view: the pill itself is tinted by speed (cyan fast, amber slow, red failed).  -->
    <Style Selector="Border.delayPill.tinted">
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.delayPill.tinted StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.delayPill.tinted TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.delayPill.tinted.fast">
        <Setter Property="Background" Value="{DynamicResource AppGoodBgBrush}" />
    </Style>
    <Style Selector="Border.delayPill.tinted.fast TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppGoodFgBrush}" />
    </Style>
    <Style Selector="Border.delayPill.tinted.slow">
        <Setter Property="Background" Value="{DynamicResource AppWarnBgBrush}" />
    </Style>
    <Style Selector="Border.delayPill.tinted.slow TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppWarnFgBrush}" />
    </Style>
    <Style Selector="Border.delayPill.tinted.bad">
        <Setter Property="Background" Value="{DynamicResource AppBadBgBrush}" />
    </Style>
    <Style Selector="Border.delayPill.tinted.bad TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppBadFgBrush}" />
    </Style>
    <Style Selector="TabControl.settingsNav">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <ItemsPresenter
                        Name="PART_ItemsPresenter"
                        Width="200"
                        Margin="0,2,16,0"
                        DockPanel.Dock="Left"
                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <ContentPresenter
                        Name="PART_SelectedContentHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{TemplateBinding SelectedContent}"
                        ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.settingsNav TabItem">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Bg"
                    Padding="14,10"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.settingsNav TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="TabControl.settingsNav TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentSoftFgBrush}" />
    </Style>
    <Style Selector="ScrollViewer.settingsPage">
        <Setter Property="Padding" Value="0,0,10,0" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="Border.settingsCard">
        <Setter Property="Padding" Value="18,14" />
    </Style>
    <!--  Label column bold, explanation column muted.  -->
    <!--  Labels wrap at 240px so long ones ("...drag-n-drop (requires restart)") can't squeeze the hint column away.  -->
    <Style Selector="Border.settingsCard > Grid > TextBlock[(Grid.Column)=0]">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!--  Controls sit on the label's line even when a long hint makes the row taller.  -->
    <Style Selector="Border.settingsCard > Grid > :is(Control)[(Grid.Column)=1]">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.settingsFill > DockPanel > TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.settingsCard > Grid > TextBlock[(Grid.Column)=2]">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <!--  Switch captions in the app's language instead of the control library's English.  -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="{x:Static resx:ResUI.TbProxyModeOn}" />
        <Setter Property="OffContent" Value="{x:Static resx:ResUI.TbProxyModeOff}" />
    </Style>
    <!--  The main window's compact switches have no caption room; their label sits beside them.  -->
    <Style Selector="Grid#gridContent ToggleSwitch">
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
    </Style>

    <!--  ===== Surfaces app-wide =====  -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
    </Style>
    <Style Selector="TextBox, ComboBox, AutoCompleteBox">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <!--  Room for the longest item plus its shortcut ("Test download speed  Ctrl+T"); opened at the
              pointer the menu otherwise came out too narrow and cut the shortcuts off.  -->
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MaxWidth" Value="480" />
    </Style>
    <Style Selector="ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="4,1" />
    </Style>

    <!--  Theme popup (the ⋮ button under the sidebar): same card look as the rest of the app.  -->
    <Style Selector="FlyoutPresenter.appearance">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="400" />
    </Style>
</Styles>
