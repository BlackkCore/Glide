    <StreamGeometry x:Key="IconTools">M14.7 2.3a6 6 0 0 1 6.6 1.3l.6.7-3.6 3.6.7 2.1 2.1.7 3.6-3.6.3.7a6 6 0 0 1-7.6 7.9l-7.6 7.6a2.5 2.5 0 0 1-3.5-3.5l7.6-7.6a6 6 0 0 1 1.2-6.6zm1.6 1.7a4 4 0 0 0-2.6 5.2l.2.6-8.5 8.5a.5.5 0 0 0 .7.7l8.5-8.5.6.2a4 4 0 0 0 5.4-3l-1.6 1.6-4-1.3-1.3-4z</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9.3 5.3l1.4-1.4 8.1 8.1-8.1 8.1-1.4-1.4 6.7-6.7z</StreamGeometry>
    <StreamGeometry x:Key="IconArrowUp">M11 20V7.8l-5.3 5.3-1.4-1.4L12 4l7.7 7.7-1.4 1.4L13 7.8V20z</StreamGeometry>
    <StreamGeometry x:Key="IconArrowDown">M13 4v12.2l5.3-5.3 1.4 1.4L12 20l-7.7-7.7 1.4-1.4 5.3 5.3V4z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M10.5 3a7.5 7.5 0 0 1 5.9 12.1l4.8 4.8-1.4 1.4-4.8-4.8A7.5 7.5 0 1 1 10.5 3zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z</StreamGeometry>
    <StreamGeometry x:Key="IconViewList">M4 5h2.5v2.5H4zm5 0h11v2.5H9zM4 10.75h2.5v2.5H4zm5 0h11v2.5H9zM4 16.5h2.5V19H4zm5 0h11V19H9z</StreamGeometry>
    <StreamGeometry x:Key="IconViewTable">M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 2v3h4V6zm6 0v3h8V6zm-6 5v3h4v-3zm6 0v3h8v-3zm-6 5v2h4v-2zm6 0v2h8v-2z</StreamGeometry>
    <StreamGeometry x:Key="IconTerminal">M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v12h16V6zm2.3 2.3L10 12l-3.7 3.7-1.4-1.4 2.3-2.3-2.3-2.3zM11 15h6v2h-6z</StreamGeometry>

    <!--  Sidebar menu item: like Semi's TopLevelMenuItem, but the submenu opens to the right.  -->
    <ControlTheme x:Key="SidebarMenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource AppNavIdleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource SidebarSubItem}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_LayoutRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <!--  Accent bar on the left edge; grows in while the item's menu is open.  -->
                        <Border
                            Name="PART_Indicator"
                            Width="3"
                            Height="18"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppAccentBrush}"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.3" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="*,Auto">
                            <ContentPresenter
                                Name="PART_HeaderPresenter"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                RecognizesAccessKey="True" />
                            <PathIcon
                                Name="PART_Chevron"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconChevronRight}"
                                Foreground="{TemplateBinding Foreground}"
                                Opacity="0.55" />
                        </Grid>
                        <Popup
                            Name="PART_Popup"
                            HorizontalOffset="10"
                            InheritsTransform="True"
                            IsLightDismissEnabled="True"
                            IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                            OverlayInputPassThroughElement="{Binding $parent[Menu]}"
                            Placement="RightEdgeAlignedTop"
                            VerticalOffset="-8"
                            WindowManagerAddShadowHint="False">
                            <Border
                                Name="PART_PopupBorder"
                                MinWidth="232"
                                MaxHeight="{DynamicResource MenuFlyoutMaxHeight}"
                                Margin="8"
                                Padding="5"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                BoxShadow="0 12 32 -8 #59000000, 0 2 6 0 #1F000000"
                                CornerRadius="12">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <ScrollViewer IsScrollChainingEnabled="False" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        Grid.IsSharedSizeScope="True"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:empty /template/ PathIcon#PART_Chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <!--  No ":selected" look: the menu keeps the last clicked item selected, which left it
              looking stuck after a click. Hover and open are the only two states.  -->
        <Style Selector="^:open">
            <Setter Property="Background" Value="{DynamicResource AppNavActiveBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppNavActiveFgBrush}" />
        </Style>
        <Style Selector="^:open /template/ PathIcon#PART_Chevron">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_Indicator">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!--  Rows inside the sidebar's popups: regular weight, one height, one hover look, a real
          checkbox for toggles, and the shortcut on the far side in a quiet tone.  -->
    <StreamGeometry x:Key="IconCheck">M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6L20.1 8.4 18.7 7z</StreamGeometry>
    <conv:PlatformKeyGestureConverter x:Key="SidebarKeyGestureConverter" />
    <!--  Icons for the rows inside the sidebar's popups (set from MainWindow).  -->
    <StreamGeometry x:Key="IconPlus">M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z</StreamGeometry>
    <StreamGeometry x:Key="IconClipboard">M9 2h6a1 1 0 0 1 1 1v1h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V3a1 1 0 0 1 1-1zm1 2v2h4V4zM6 6v14h12V6h-2v2H8V6z</StreamGeometry>
    <StreamGeometry x:Key="IconScan">M3 3h6v2H5v4H3zm12 0h6v6h-2V5h-4zM3 15h2v4h4v2H3zm16 0h2v6h-6v-2h4zM3 11h18v2H3z</StreamGeometry>
    <StreamGeometry x:Key="IconImage">M3 4h18v16H3zm2 2v12h14V6zm1 10 4-5 3 3.5 2-2.5 3 4zm9-8a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>
    <StreamGeometry x:Key="IconFileCode">M5 2h9l6 6v14H5zm2 2v16h11V9h-5V4zm3.6 8 1.4 1.4-1.6 1.6 1.6 1.6-1.4 1.4-3-3zm2.8 1.4 1.4-1.4 3 3-3 3-1.4-1.4 1.6-1.6z</StreamGeometry>
    <StreamGeometry x:Key="IconLayers">M12 2 22 7l-10 5L2 7zm0 2.2L6.5 7 12 9.8 17.5 7zM4.2 11.1 12 15l7.8-3.9L22 12l-10 5-10-5zm0 5L12 20l7.8-3.9L22 17l-10 5-10-5z</StreamGeometry>
    <StreamGeometry x:Key="IconChain">M5 9.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zm7 0a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zm7 0a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM7.5 11h2v2h-2zm7 0h2v2h-2z</StreamGeometry>
    <StreamGeometry x:Key="IconOutbound">M14 3h7v7h-2V6.4l-7.3 7.3-1.4-1.4L17.6 5H14zM5 5h6v2H6v11h11v-5h2v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M4 6h9v2H4zm13 0h3v2h-3zM15 4h2v6h-2zM4 16h3v2H4zm7 0h9v2h-9zM7 14h2v6H7z</StreamGeometry>
    <StreamGeometry x:Key="IconApps">M4 4h6v6H4zm2 2v2h2V6zm8-2h6v6h-6zm2 2v2h2V6zM4 14h6v6H4zm2 2v2h2v-2zm10-2h2v3h3v2h-3v3h-2v-3h-3v-2h3z</StreamGeometry>
    <StreamGeometry x:Key="IconArchive">M3 4h18v5h-1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9H3zm2 2v1h14V6zm1 3v10h12V9zm4 2h4v2h-4z</StreamGeometry>
    <StreamGeometry x:Key="IconDatabase">M12 3c4.4 0 8 1.3 8 3v12c0 1.7-3.6 3-8 3s-8-1.3-8-3V6c0-1.7 3.6-3 8-3zm0 2C8.3 5 6 6 6 6.5S8.3 8 12 8s6-1 6-1.5S15.7 5 12 5zM6 9v3c0 .5 2.3 1.5 6 1.5s6-1 6-1.5V9c-1.5.8-3.6 1-6 1s-4.5-.2-6-1zm0 6v3c0 .5 2.3 1.5 6 1.5s6-1 6-1.5v-3c-1.5.8-3.6 1-6 1s-4.5-.2-6-1z</StreamGeometry>
    <StreamGeometry x:Key="IconImport">M11 3h2v9.6l3.3-3.3 1.4 1.4L12 16.4l-5.7-5.7 1.4-1.4 3.3 3.3zM4 15h2v4h12v-4h2v6H4z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3 5a1 1 0 0 1 1-1h6l2 2h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zm2 1v12h14V8h-7.8l-2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconGlobe">M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm-1.9 2.2A8 8 0 0 0 4.1 11h3.4c.1-2.5.9-4.9 2.6-6.8zm3.8 0c1.7 1.9 2.5 4.3 2.6 6.8h3.4a8 8 0 0 0-6-6.8zM12 4.6c-1.5 1.7-2.4 4-2.5 6.4h5c-.1-2.4-1-4.7-2.5-6.4zM4.1 13a8 8 0 0 0 6 6.8c-1.7-1.9-2.5-4.3-2.6-6.8zm5.4 0c.1 2.4 1 4.7 2.5 6.4 1.5-1.7 2.4-4 2.5-6.4zm7 0c-.1 2.5-.9 4.9-2.6 6.8a8 8 0 0 0 6-6.8z</StreamGeometry>
    <StreamGeometry x:Key="IconKeyboard">M3 6h18a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm1 2v8h16V8zm2 1h2v2H6zm3 0h2v2H9zm3 0h2v2h-2zm3 0h2v2h-2zM7 13h10v2H7z</StreamGeometry>
    <StreamGeometry x:Key="IconPalette">M12 2a10 10 0 0 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.4A4.6 4.6 0 0 0 22 10.8C22 5.9 17.5 2 12 2zM6.5 11a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm3-4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm5 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm3 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M9 3h6l1 1h4v2H4V4h4zM6 8h12l-1 13H7zm2.1 2 .8 9h6.2l.8-9z</StreamGeometry>
    <ControlTheme x:Key="SidebarSubItem" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource AppNavIdleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource SidebarSubItem}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_LayoutRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <Grid
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            ColumnDefinitions="Auto,*,Auto,Auto">
                            <!--  Icon slot, always the same width so every label starts at the same place;
                                  a toggle row shows its checkbox here instead.  -->
                            <Panel
                                Width="18"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                                <ContentPresenter
                                    Name="PART_IconPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    Foreground="{DynamicResource AppMutedBrush}" />
                                <Border
                                    Name="PART_ToggleBox"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    IsVisible="False">
                                    <PathIcon
                                        Name="PART_Check"
                                        Width="11"
                                        Height="11"
                                        Data="{StaticResource IconCheck}"
                                        Foreground="{DynamicResource AppOnAccentBrush}"
                                        IsVisible="False" />
                                </Border>
                            </Panel>
                            <ContentPresenter
                                Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                RecognizesAccessKey="True" />
                            <TextBlock
                                Name="PART_Gesture"
                                Grid.Column="2"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource AppFontSmall}"
                                Foreground="{DynamicResource AppFaintBrush}"
                                Text="{TemplateBinding InputGesture, Converter={StaticResource SidebarKeyGestureConverter}}" />
                            <PathIcon
                                Name="PART_Chevron"
                                Grid.Column="3"
                                Width="9"
                                Height="9"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconChevronRight}"
                                Foreground="{DynamicResource AppFaintBrush}" />
                        </Grid>
                        <Popup
                            Name="PART_Popup"
                            HorizontalOffset="4"
                            IsLightDismissEnabled="False"
                            IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                            Placement="RightEdgeAlignedTop"
                            VerticalOffset="-14"
                            WindowManagerAddShadowHint="False">
                            <Border
                                Name="PART_PopupBorder"
                                MinWidth="200"
                                Margin="8"
                                Padding="5"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                BoxShadow="0 12 32 -8 #59000000, 0 2 6 0 #1F000000"
                                CornerRadius="12">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:empty /template/ PathIcon#PART_Chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pointerover, ^:open">
            <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_IconPresenter, ^:open /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="^:toggle /template/ Border#PART_ToggleBox">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_ToggleBox">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ PathIcon#PART_Check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

    <!--  Pill-shaped filter chips (subscription groups)  -->
    <ControlTheme x:Key="ChipListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Bg"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentSoftFgBrush}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="ChipListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource ChipListBoxItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  Segmented control (system proxy mode)  -->
    <ControlTheme x:Key="SegmentListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Bg"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource AppSegmentSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Bg">
            <Setter Property="BoxShadow" Value="{DynamicResource AppRaisedShadow}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="SegmentListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentListBoxItem}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <!--  Toasts: a small card with an accent badge, sliding in from above and fading out.
          Replaces Semi's grey pill so notices match the rest of the redesign.  -->
    <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ContentTemplate">
            <DataTemplate x:DataType="INotification">
                <DockPanel>
                    <Border
                        Width="28"
                        Height="28"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppAccentSoftBrush}"
                        CornerRadius="9"
                        DockPanel.Dock="Left">
                        <PathIcon
                            Width="14"
                            Height="14"
                            Data="{StaticResource SemiIconInfoCircle}"
                            Foreground="{DynamicResource AppAccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontWeight="Medium"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Margin="8,4,8,10"
                    Padding="12,10,16,10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BoxShadow="{DynamicResource AppToastShadow}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^">
            <Style.Animations>
                <Animation
                    Easing="QuinticEaseOut"
                    FillMode="Backward"
                    Duration="0:0:0.32">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!--  The card is only removed once IsClosed is set, so the fade-out sets it on its last frame.  -->
        <Style Selector="^[IsClosing=true]">
            <Style.Animations>
                <Animation
                    Easing="CubicEaseIn"
                    FillMode="Forward"
                    Duration="0:0:0.2">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-8" />
                        <Setter Property="IsClosed" Value="True" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>
</ResourceDictionary>
