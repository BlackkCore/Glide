<UserControl
    x:Class="v2rayN.Desktop.Views.MsgView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Design.DataContext="{x:Static dd:DesignData.Msg}"
    mc:Ignorable="d">
    <DockPanel>
        <!--  One row: title, search (flexes), actions and the two toggles. On narrow cards the toggle labels hide.  -->
        <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
            <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Classes="h2"
                DockPanel.Dock="Left"
                Text="{x:Static resx:ResUI.MsgInformationTitle}" />

            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="14">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    ToolTip.Tip="{x:Static resx:ResUI.TbAutoRefresh}">
                    <TextBlock
                        x:Name="lblAutoRefresh"
                        Classes="toggleLabel"
                        Text="{x:Static resx:ResUI.TbAutoRefresh}" />
                    <ToggleSwitch
                        x:Name="togAutoRefresh"
                        HorizontalAlignment="Left"
                        IsChecked="True"
                        Theme="{DynamicResource SimpleToggleSwitch}" />
                </StackPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    ToolTip.Tip="{x:Static resx:ResUI.TbAutoScrollToEnd}">
                    <TextBlock
                        x:Name="lblScrollToEnd"
                        Classes="toggleLabel"
                        Text="{x:Static resx:ResUI.TbAutoScrollToEnd}" />
                    <ToggleSwitch
                        x:Name="togScrollToEnd"
                        HorizontalAlignment="Left"
                        IsChecked="True"
                        Theme="{DynamicResource SimpleToggleSwitch}" />
                </StackPanel>
            </StackPanel>

            <Border
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                Classes="toolbar"
                DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="btnCopy"
                        Classes="IconButton"
                        Click="menuMsgViewCopyAll_Click"
                        ToolTip.Tip="{x:Static resx:ResUI.menuMsgViewCopyAll}">
                        <PathIcon Data="{StaticResource SemiIconCopy}" />
                    </Button>
                    <Button
                        x:Name="btnClear"
                        Classes="IconButton"
                        Click="menuMsgViewClear_Click"
                        ToolTip.Tip="{x:Static resx:ResUI.menuMsgViewClear}">
                        <PathIcon Data="{StaticResource SemiIconDelete}" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  The search box grows up to 240px and stays next to the title; extra width stays empty.  -->
            <Grid Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="110" MaxWidth="240" />
                    <ColumnDefinition Width="0.001*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="cmbMsgFilter"
                    Classes="search"
                    PlaceholderText="{x:Static resx:ResUI.MsgFilterTitle}"
                    ToolTip.Tip="{x:Static resx:ResUI.MsgFilterTitle}">
                    <TextBox.InnerLeftContent>
                        <PathIcon Classes="searchIcon" Data="{StaticResource IconSearch}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>
        </DockPanel>

        <Border Classes="logPanel">
            <avaloniaEdit:TextEditor
                Name="txtMsg"
                Padding="10,8"
                Background="Transparent"
                FontFamily="{StaticResource AppMonoFont}"
                FontSize="{DynamicResource AppFontSmall}"
                Foreground="{DynamicResource AppMutedBrush}"
                IsReadOnly="True"
                VerticalScrollBarVisibility="Auto"
                WordWrap="True">
                <avaloniaEdit:TextEditor.Options>
                    <avaloniaEdit:TextEditorOptions AllowScrollBelowDocument="False" />
                </avaloniaEdit:TextEditor.Options>
                <avaloniaEdit:TextEditor.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem
                            x:Name="menuMsgViewSelectAll"
                            Click="menuMsgViewSelectAll_Click"
                            Header="{x:Static resx:ResUI.menuMsgViewSelectAll}"
                            InputGesture="Ctrl+A" />
                        <MenuItem
                            x:Name="menuMsgViewCopy"
                            Click="menuMsgViewCopy_Click"
                            Header="{x:Static resx:ResUI.menuMsgViewCopy}"
                            InputGesture="Ctrl+C" />
                        <MenuItem
                            x:Name="menuMsgViewCopyAll"
                            Click="menuMsgViewCopyAll_Click"
                            Header="{x:Static resx:ResUI.menuMsgViewCopyAll}" />
                        <MenuItem
                            x:Name="menuMsgViewClear"
                            Click="menuMsgViewClear_Click"
                            Header="{x:Static resx:ResUI.menuMsgViewClear}" />
                    </MenuFlyout>
                </avaloniaEdit:TextEditor.ContextFlyout>
            </avaloniaEdit:TextEditor>
        </Border>
    </DockPanel>
</UserControl>
